NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# Public address of the web app (CORS, CSRF checks and redirects after sign-in).
WEB_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API in production.
TRUST_PROXY=0

# pglite:<dir> runs an embedded PostgreSQL (no Docker needed).
# With Docker: postgres://acu:<password>@localhost:5432/acu_platform
DATABASE_URL=pglite:.data/dev-db

# Google sign-in. See docs/google-sign-in.md. Leave empty to run without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

UNIVERSITY_EMAIL_DOMAIN=acu.edu.eg

# console prints emails in the terminal; smtp sends them.
MAIL_TRANSPORT=console
# e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=ACU Languages <no-reply@localhost>

# Uploaded photos and attachments: disk (UPLOADS_DIR) or database (for hosts without a lasting disk).
STORAGE_DRIVER=disk
UPLOADS_DIR=.data/uploads
